{
  "name": "npm-uebung",
  "version": "1.0.0",
  "description": "MEDT-NPM-Uebung",
  "main": "index.js",
  "scripts": {
  "scss:build": "sass src/scss/style.scss dist/css/style.css --style=compressed --quiet-deps --silence-deprecation=import",
  "scss:watch": "sass --watch src/scss/style.scss dist/css/style.css --quiet-deps --silence-deprecation=import",
  "serve": "browser-sync start --server --files \"*.html, dist/css/*.css\"",
  "dev": "npm-run-all --parallel scss:watch serve"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.2"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "npm-run-all": "^4.1.5",
    "sass": "^1.108.0"
  }
}
